package ontap;

import java.util.ArrayList;
import java.util.Scanner;

	class Date{
		int ngay,thang,nam;
		
		void nhap(Scanner sc) {
			System.out.println("nhap ngay thang nam: ");
			ngay = sc.nextInt();
			thang = sc.nextInt();
			nam = sc.nextInt();
			sc.nextLine();
		}
		void in() {
			System.out.println(ngay + "/" + thang + "/" + nam);
		}
	}
	
	class KhachHang{
		String cccd,hten,dchi;
		double tLeGiam = 0;
		
		void nhap(Scanner sc) {
			System.out.println("CCCD: ");
			cccd = sc.nextLine();
			System.out.println("Ho Ten: ");
			hten = sc.nextLine();
			System.out.println("Dia chi: ");
			dchi = sc.nextLine();
			sc.nextLine();
		}
		void in() {
			System.out.println("Khach hang " + hten + " - " + dchi);
		}
	}
	
	class KhachHangVIP extends KhachHang{
		void nhap(Scanner sc) {
			super.nhap(sc);
			System.out.println("nhap ti le giam: ");
			tLeGiam = sc.nextDouble();
			sc.nextLine();
		}
		void in() {
			super.in();
			System.out.println("VIP Giam: " + tLeGiam);
		}
	}
	
	class HangHoa{
		String mso,ten,nsxuat;
		 
		void nhap(Scanner sc) {
			System.out.println("Ma so: ");
