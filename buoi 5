	class ChiTiet{
		HangHoa hang = new HangHoa();
		int sluong;
		double dgia;
		
		void nhap(Scanner sc) {
			System.out.println("Nhap so luong: ");
			sluong = sc.nextInt();
			System.out.println("nhap don gia: ");
			dgia = sc.nextDouble();
			sc.nextLine();
		}
		void in() {
			System.out.println();
			hang.in();
			System.out.println("| SL" + sluong + "| DG" +dgia);
		}
		double thanhTien() {
			return sluong*dgia;
		}
	}
	
	class HoaDon{
		String mso,tde,nvien;
		KhachHang kh;
		Date ngayLap = new Date();
		ArrayList<ChiTiet>ds = new ArrayList<>();
		
		void nhap(Scanner sc) {
			System.out.println("Ma so: ");
			mso = sc.nextLine();
			System.out.println("tieu de: ");
			tde = sc.nextLine();
			System.out.println("nhan vien: ");
			nvien = sc.nextLine();
			sc.nextLine();
			
			System.out.println("Khach vip? (1 = co, 0 = khong): ");
			int vip = sc.nextInt();
			sc.nextLine();
			kh = (vip == 1)? new KhachHangVIP() : new KhachHang();
			kh.nhap(sc);
			
			ngayLap.nhap(sc);
			
			System.out.println("so don chi tiet: ");
			int n = sc.nextInt();
			sc.nextLine();
			for(int i = 0; i < n;i++) {
				System.out.println(" " + (i + 1));
				ChiTiet ct = new ChiTiet();
				ct.nhap(sc);
				ds.add(ct);
			}
		}
		
		double tong() {
			int s = 0;
			for(ChiTiet ct : ds) s+=ct.thanhTien();
			return s*(1-kh.tLeGiam);
		}
		void in() {
			System.out.println("Ma so" + mso + " " + tde + " " + nvien+ "NGAY");
			ngayLap.in();
			System.out.println();
			kh.in();
			for(ChiTiet ct : ds) ct.in();
			System.out.println("TONG" + tong());
			System.out.println();
		}
	}
	public class nhapkitu{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		System.out.println("nhap n: ");
		int n = sc.nextInt();
		sc.nextLine();
		
		ArrayList<HoaDon>ds = new ArrayList<>();
		for(int i = 0; i < n; i++) {
			System.out.println("nhap hoa don: " +(i + 1));
			HoaDon hd = new HoaDon();
			hd.nhap(sc);
			ds.add(hd);
		}
		
		System.out.println("Hoas don tren 1 trieu");
		for(HoaDon hd : ds)
			if(hd.tong() > 1000000) hd.in();
		System.out.println("20/05/2022");
		for(HoaDon hd : ds)
			if(hd.ngayLap.ngay == 20 && hd.ngayLap.thang == 5 && hd.ngayLap.nam==2022)
				System.out.println(hd.kh.hten);
	}
}
